{
  "name": "figma-to-powerpoint",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin that exports frames and Figma Slides to editable PowerPoint (.pptx) decks.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node build.mjs --tests && node --test \"dist-test/*.test.mjs\"",
    "check": "npm run typecheck && npm run build && npm test",
    "compare": "node tools/compare.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^4.5.7",
    "jszip": "^3.10.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
